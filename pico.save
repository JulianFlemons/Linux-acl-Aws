#!/bin/bash
# ---------------------------------------------------------------
# Project: Linux Company Access Control System (AWS EC2)
# Author: [Your Name]
# Description: Script to set up users, groups, shared directories,
# and enforce least-privilege permissions (2770 + SGID).
# ---------------------------------------------------------------

echo "--- 1. System Update ---"
sudo apt update
sudo apt upgrade -y

echo "--- 2. Directory Structure Creation ---"
sudo mkdir /company_data
sudo mkdir /company_data/dev_share
sudo mkdir /company_data/hr_share

echo "--- 3. User and Group Configuration ---"
sudo groupadd dev
sudo groupadd hr
sudo useradd -m -s /bin/bash -g dev dev_user1
sudo useradd -m -s /bin/bash -g dev dev_user2
sudo useradd -m -s /bin/bash -g hr hr_user1
sudo useradd -m -s /bin/bash -g hr hr_user2

echo "--- 4. Enforcing Least-Privilege Permissions ---"
# Assign Group Ownership (chown :group)
sudo chown :dev /company_data/dev_share
sudo chown :hr /company_data/hr_share

# Apply SGID Permissions (chmod 2770)
sudo chmod 2770 /company_data/dev_share
sudo chmod 2770 /company_data/hr_share

echo "--- 5. Security & Validation Preparation ---"
# Note: Passwords were set manually for 'su' validation on the server.
# We lock the passwords for security best practice when deployment is complete.
sudo passwd -l dev_user1
sudo passwd -l dev_user2
sudo passwd -l hr_user1
sudo passwd -l hr_user2

